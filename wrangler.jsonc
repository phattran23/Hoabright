{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hoabright-university",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hoabright-db",
      // Thay bằng ID nhận được từ lệnh: npx wrangler d1 create hoabright-db
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
